DATABASE_URL=postgresql+psycopg://placemates:placemates@localhost:5432/placemates
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Production: the frontend proxies /api, so set this to https://<your-frontend>/api (see docs/deploy.md).
PUBLIC_API_URL=

# Random strings. Generate the Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me
SESSION_SECRET=change-me
TOKEN_ENCRYPTION_KEY=

# Google Cloud console -> OAuth client (Web). Redirect URI: {PUBLIC_API_URL or BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI: Groq runs every agent; Gemini (optional) writes resumes while its free quota lasts
GROQ_API_KEY=
GEMINI_API_KEY=

# Jobs: company boards need no keys. Optional extra sources:
JOBS_DAILY_FETCH=false
JOBS_FRESH_DAYS=3
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
APIFY_API_KEY=
APIFY_MONTHLY_BUDGET_USD=4.5

# Daily digest: top-N tailored resumes, then one email from the student's Gmail
RESUMES_PER_DAY=3
DAILY_EMAIL=true
# Secret for POST /internal/daily (external cron on hosts that sleep). Empty = disabled.
CRON_SECRET=
