DATABASE_URL=postgresql+psycopg://placemates:placemates@localhost:5432/placemates
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Random strings. Generate the Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me
SESSION_SECRET=change-me
TOKEN_ENCRYPTION_KEY=

# Google Cloud console -> OAuth client (Web). Redirect URI: {BACKEND_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cheap model for extraction and profile questions
GROQ_API_KEY=

# Jobs: company boards need no keys. Optional extra sources:
JOBS_DAILY_FETCH=false
JOBS_FRESH_DAYS=3
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
APIFY_API_KEY=
APIFY_MONTHLY_BUDGET_USD=4.5
